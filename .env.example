# Copied to .env and loaded by bin/dev (foreman).

# Mocked replies by default, so the app runs with no API key and costs nothing.
LLM_MOCK=1
LLM_MOCK_LATENCY_MS=1500

# For real replies: set a Groq key and remove LLM_MOCK above.
# XAI_API_KEY=gsk_your_groq_key

# Database and Redis default to localhost (config/database.yml, redis://localhost:6379/0).
# Override only if yours differ:
# DATABASE_URL=postgresql://localhost/ever_chat_development
# REDIS_URL=redis://localhost:6379/0
