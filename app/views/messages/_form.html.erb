<%= form_with url: conversation_messages_path(conversation),
      id: "message_form",
      data: { turbo_stream: true, controller: "message-form" },
      class: "shrink-0 pt-4 border-t border-gray-200" do |f| %>
  <div class="flex gap-2 items-end">
    <%= f.text_area :content,
          rows: 1,
          autofocus: true,
          placeholder: "Message…",
          class: "flex-1 resize-none rounded-xl border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500",
          data: { action: "keydown.enter->message-form#submit:prevent" } %>
    <%= f.submit "Send",
          class: "rounded-xl bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500 cursor-pointer shrink-0" %>
  </div>
<% end %>
