<%= form_with url: conversation_messages_path(conversation), scope: :message,
      id: "message_form",
      data: { turbo_stream: true, controller: "message-form" },
      class: "shrink-0 px-8 py-5 border-t border-[#ede9e3]" do |f| %>
  <div class="relative flex items-end gap-2 bg-white rounded-2xl border border-[#e0dbd4] shadow-sm focus-within:border-[#c8c2ba] focus-within:shadow transition-shadow">
    <%= f.text_area :content,
          rows: 1,
          autofocus: true,
          placeholder: "Message PulseChat…",
          class: "flex-1 resize-none bg-transparent px-4 py-3 text-sm text-gray-800 placeholder-gray-400 focus:outline-none leading-relaxed",
          data: { action: "keydown.enter->message-form#submit:prevent" } %>
    <%= f.submit class: "shrink-0 mr-2 mb-2 w-8 h-8 rounded-xl bg-[#cc785c] hover:bg-[#b8694e] flex items-center justify-center cursor-pointer transition-colors text-white",
          value: "↑" %>
  </div>
<% end %>
