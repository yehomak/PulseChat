<div id="<%= dom_id(message) %>" class="flex gap-3 px-4 py-3 <%= message.role_assistant? ? 'bg-gray-50' : '' %>">
  <span class="text-xs font-semibold uppercase tracking-wide text-gray-400 w-16 shrink-0 pt-0.5">
    <%= message.role_assistant? ? "AI" : "You" %>
  </span>

  <div class="flex-1 text-sm text-gray-800">
    <%= message.content %>
    <% if message.status_pending? || message.status_streaming? %>
      <span class="inline-block ml-1 animate-pulse text-gray-400">…</span>
      <%= button_to "Stop", cancel_conversation_message_path(conversation, message),
            method: :patch,
            class: "ml-2 text-xs text-red-400 hover:text-red-600 underline" %>
    <% elsif message.status_cancelled? %>
      <span class="ml-2 text-xs text-gray-400 italic">Generation stopped</span>
    <% elsif message.status_failed? %>
      <span class="ml-2 text-xs text-red-400 italic">Generation failed</span>
    <% end %>
  </div>
</div>
