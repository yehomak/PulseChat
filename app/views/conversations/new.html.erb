<% content_for :title, "New Conversation — PulseChat" %>

<div class="w-full max-w-2xl mx-auto">
  <h1 class="text-2xl font-semibold text-gray-900 mb-6">New conversation</h1>

  <%= form_with model: @conversation, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :title, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :title, autofocus: true,
            class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500",
            placeholder: "What's this conversation about?" %>
      <% @conversation.errors[:title].each do |msg| %>
        <p class="mt-1 text-xs text-red-600"><%= msg %></p>
      <% end %>
    </div>

    <%= f.submit "Create", class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500 cursor-pointer" %>
    <%= link_to "Cancel", conversations_path, class: "ml-3 text-sm text-gray-500 hover:text-gray-700" %>
  <% end %>
</div>
