<% content_for :title, "#{@conversation.title} — PulseChat" %>
<% content_for :main_class, "h-screen flex overflow-hidden w-full" %>

<%= turbo_stream_from @conversation %>

<%# Chat column %>
<div class="flex-1 flex flex-col min-w-0">

  <%# Header %>
  <div class="shrink-0 flex items-center gap-3 px-8 py-4 border-b border-[#ede9e3]">
    <%= link_to conversations_path, class: "text-gray-400 hover:text-gray-600 transition-colors" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
      </svg>
    <% end %>
    <h1 class="text-sm font-medium text-gray-700 truncate"><%= @conversation.title %></h1>
    <div class="ml-auto">
      <%= button_to conversation_path(@conversation), method: :delete,
            class: "text-xs text-gray-300 hover:text-red-400 transition-colors",
            data: { turbo_confirm: "Delete this conversation?" } do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
        </svg>
      <% end %>
    </div>
  </div>

  <%# Messages %>
  <div id="messages" class="flex-1 overflow-y-auto py-6 space-y-1">
    <%= render partial: "messages/message", collection: @messages, locals: { conversation: @conversation } %>
  </div>

  <%# Input form %>
  <%= render "messages/form", conversation: @conversation %>
</div>

<%# Right info panel %>
<div class="w-56 shrink-0 border-l border-[#ede9e3] bg-[#f3f0eb] flex flex-col gap-6 px-5 py-6">
  <%# User avatar + email %>
  <div class="flex flex-col gap-2">
    <div class="w-8 h-8 rounded-full bg-[#cc785c] flex items-center justify-center text-white text-xs font-semibold">
      <%= Current.user.email_address.first.upcase %>
    </div>
    <p class="text-xs text-gray-500 break-all leading-relaxed"><%= Current.user.email_address %></p>
  </div>

  <%# Token balance %>
  <div class="flex flex-col gap-1">
    <p class="text-[11px] font-medium text-gray-400 uppercase tracking-wider">Balance</p>
    <p class="text-sm font-medium text-gray-700"><%= number_with_delimiter(Current.user.token_balance) %> tokens</p>
  </div>

  <%# New chat %>
  <div class="mt-auto">
    <%= link_to "New chat", new_conversation_path,
          class: "block text-center text-xs font-medium text-gray-500 hover:text-gray-800 border border-[#ddd9d3] hover:border-gray-400 rounded-lg py-2 transition-colors" %>
  </div>
</div>
